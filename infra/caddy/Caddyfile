{$URL} {
	tls {$CERTIFICATE} {$PRIVATE_KEY}

	import headers.caddy

	# 접근 로그 — 학교 보안 기준으로 1년 보관. Caddy 는 Cookie·Authorization 헤더를 기본으로 가린다.
	log {
		output file /data/logs/access.log {
			roll_size 100MiB
			roll_keep 1000
			roll_keep_for 8760h
		}
		format json
	}
	header Strict-Transport-Security "max-age=31536000"

	# Frontend
	reverse_proxy host.docker.internal:3000

	# Backend
	reverse_proxy /api/* host.docker.internal:8080

	# Old file serving
	reverse_proxy /sites/default/files/* host.docker.internal:8080

    # Login
    reverse_proxy /oauth2/authorization/idsnucse host.docker.internal:8080 

	# Grafana — 팀에 공개. Grafana 자체 인증(계정)으로 막는다.
	# Prometheus(9090)는 열지 않는다 — 무인증이고 /api/v1/status/config 가 내부 구조를 그대로 준다.
	reverse_proxy /grafana* host.docker.internal:3001

	# GoatCounter — 페이지 조회 통계
	reverse_proxy /stats* host.docker.internal:8081

	# Swagger 는 운영에서 열지 않는다(학교 보안점검 2026-11). staging(Caddyfile.dev)에서만 본다.
}
