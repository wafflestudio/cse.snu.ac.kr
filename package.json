{
  "name": "csereal",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "knip": "knip",
    "prepare": "node .husky/install.mjs || true",
    "test": "bash scripts/e2e-docker.sh",
    "test:ui": "bash scripts/e2e-docker.sh --ui",
    "gen:api": "bash scripts/gen-api.sh",
    "backend:up": "docker compose up -d --build --wait backend",
    "backend:down": "docker compose down",
    "deploy:staging": "scripts/deploy.sh staging",
    "deploy:prod": "scripts/deploy.sh prod"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.9",
    "husky": "^9.1.7",
    "knip": "^6.17.1",
    "lint-staged": "^16.2.7",
    "typescript": "^5.9.2"
  }
}
