{
  "name": "csereal",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "web:dev": "pnpm --filter web dev",
    "web:build": "pnpm --filter web build",
    "web:start": "pnpm --filter web start",
    "api:up": "docker compose -f infra/compose.yml -f infra/compose.local.yml up -d --build --wait backend",
    "api:down": "docker compose -f infra/compose.yml -f infra/compose.local.yml down",
    "api:test": "cd apps/api && ./gradlew test",
    "test": "pnpm api:test && pnpm e2e",
    "e2e": "bash e2e/run.sh",
    "e2e:ui": "bash e2e/run.sh --ui",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "knip": "knip",
    "gen:api": "pnpm api:up && pnpm --filter web exec openapi-typescript http://localhost:8080/api-docs/json -o src/types/api/generated.d.ts && pnpm typecheck",
    "prepare": "node .husky/install.mjs || true"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.9",
    "husky": "^9.1.7",
    "knip": "^6.17.1",
    "lint-staged": "^16.2.7",
    "typescript": "^5.9.2"
  }
}
