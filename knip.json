{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [],
      "project": []
    },
    "apps/web": {
      "entry": [
        "src/routes/**/*.{ts,tsx}",
        "src/router.tsx",
        "src/sitemap.tsx"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@types/mdx", "openapi-typescript", "tailwindcss"]
    },
    "e2e": {
      "entry": ["tests/**/*.spec.ts"],
      "project": ["tests/**/*.ts"]
    }
  }
}
