{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/routes/**/*.{ts,tsx}",
    "src/router.tsx",
    "src/sitemap.tsx",
    "src/**/*.stories.tsx",
    ".storybook/{main,preview}.{ts,tsx}",
    "tests/**/*.spec.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "tests/**/*.ts"],
  "ignoreBinaries": ["scripts/deploy.sh"],
  "ignoreDependencies": ["tailwindcss"]
}
